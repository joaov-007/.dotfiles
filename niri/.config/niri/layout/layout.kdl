// ─── Layout & Animations ────────────────────────────────────────────
//  Included from config.kdl — edit here, not in config.kdl

layout {
    gaps 6

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        off
    }

    border {
        off
    }
}

// ─── Animations (OFF for blazing fast) ─────────────────────────────
animations {
    off
}
