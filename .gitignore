# Obsidian snippets (generated/theme-specific)
.obsidian/snippets/*
!/.obsidian/snippets/
!.obsidian/snippets/.gitkeep
**/.obsidian/snippets/*
!**/.obsidian/snippets/
!**/.obsidian/snippets/.gitkeep

# Obsidian plugins/cache (rarely tracked)
