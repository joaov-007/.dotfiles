# Linear history.
#
# A pull rebases instead of merging, a push sends only the branch you are
# on, and a rebase stashes your work instead of refusing to start. The
# result is a history that is a straight line, with no merge commits to
# untangle later.
[rebase]
	autoStash = true
	autoSquash = true
[pull]
	rebase = true
[push]
	default = current
# zdiff3 keeps the common ancestor in the middle of a conflict, instead of
# only showing ours and theirs.
[merge]
	conflictStyle = zdiff3

# Remember how a conflict was resolved, so the same one does not have to
# be solved twice while rebasing.
[rerere]
	enabled = true

# delta renders the diffs.
[core]
	pager = delta
[interactive]
	diffFilter = delta --paging=never
