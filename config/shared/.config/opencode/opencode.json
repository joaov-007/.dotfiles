{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    }
  ],
  "experimental": {
    "portable_shell_scanner": true
  },

  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "brasil": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "mcp-brasil",
          "python",
          "-m",
          "mcp_brasil.server"
        ],
        "disabled": true
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "hallux": {
        "type": "remote",
        "url": "https://api.blvkware.dev/hallux/mcp"
      },
      "fff": {
        "type": "local",
        "command": [
          "/home/joaov/.local/bin/fff-mcp"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "mansplain": {
        "type": "local",
        "command": [
          "/home/joaov/.local/bin/mansplain"
        ]
      },
      "markitdown": {
        "type": "local",
        "command": [
          "uvx",
          "markitdown-mcp"
        ]
      }
    }
  },
  "plugins": [
    "opencode-memory"
  ],
  "formatter": {},
  "lsp": {}
}
