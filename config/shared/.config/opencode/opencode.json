{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*.env",
      "effect": "deny"
    }
  ],
  "experimental": {
    "portable_shell_scanner": true
  },

  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "brasil": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "mcp-brasil",
          "python",
          "-m",
          "mcp_brasil.server"
        ],
        "disabled": true
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "hallux": {
        "type": "remote",
        "url": "https://api.blvkware.dev/hallux/mcp"
      },
      "fff": {
        "type": "local",
        "command": [
          "/home/joaov/.local/bin/fff-mcp"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "mansplain": {
        "type": "local",
        "command": [
          "/home/joaov/.local/bin/mansplain"
        ]
      },
      "markitdown": {
        "type": "local",
        "command": [
          "uvx",
          "markitdown-mcp"
        ]
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      },
      "fetch": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-fetch"
        ]
      },
      "youtube-transcript": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@kimtaeyoon83/mcp-server-youtube-transcript"
        ]
      }
    }
  },
  "plugins": [
    "opencode-memory"
  ],
  "formatter": {},
  "lsp": {},
  "providers": {
    "litellm": {
      "name": "LiteLLM (local proxy)",
      "env": ["LITELLM_MASTER_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "local-general": { "name": "Local General" },
        "local-code": { "name": "Local Code" },
        "cloud-groq": { "name": "Groq gpt-oss-20b" },
        "cloud-groq-big": { "name": "Groq gpt-oss-120b" },
        "cloud-mistral": { "name": "Mistral Small" },
        "cloud-code": { "name": "Codestral" },
        "cloud-free": { "name": "OpenRouter Free" }
      }
    }
  }
}
