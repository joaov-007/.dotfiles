// ─── Workspaces ───
//  Included from binds.kdl — edit here, not in binds.kdl
binds {

    // ── Workspaces (vim :bn/:bp tabs) ──
    Mod+1 hotkey-overlay-title="Focus Workspace 1: focus-workspace 1" { focus-workspace 1; }
    Mod+2 hotkey-overlay-title="Focus Workspace 2: focus-workspace 2" { focus-workspace 2; }
    Mod+3 hotkey-overlay-title="Focus Workspace 3: focus-workspace 3" { focus-workspace 3; }
    Mod+4 hotkey-overlay-title="Focus Workspace 4: focus-workspace 4" { focus-workspace 4; }
    Mod+5 hotkey-overlay-title="Focus Workspace 5: focus-workspace 5" { focus-workspace 5; }
    Mod+6 hotkey-overlay-title="Focus Workspace 6: focus-workspace 6" { focus-workspace 6; }
    Mod+7 hotkey-overlay-title="Focus Workspace 7: focus-workspace 7" { focus-workspace 7; }
    Mod+8 hotkey-overlay-title="Focus Workspace 8: focus-workspace 8" { focus-workspace 8; }
    Mod+9 hotkey-overlay-title="Focus Workspace 9: focus-workspace 9" { focus-workspace 9; }
    Mod+0 hotkey-overlay-title="Focus Workspace 10: focus-workspace 10" { focus-workspace 10; }
    Mod+Shift+1 hotkey-overlay-title="Move Column to Workspace 1: move-column-to-workspace 1" { move-column-to-workspace 1; }
    Mod+Shift+2 hotkey-overlay-title="Move Column to Workspace 2: move-column-to-workspace 2" { move-column-to-workspace 2; }
    Mod+Shift+3 hotkey-overlay-title="Move Column to Workspace 3: move-column-to-workspace 3" { move-column-to-workspace 3; }
    Mod+Shift+4 hotkey-overlay-title="Move Column to Workspace 4: move-column-to-workspace 4" { move-column-to-workspace 4; }
    Mod+Shift+5 hotkey-overlay-title="Move Column to Workspace 5: move-column-to-workspace 5" { move-column-to-workspace 5; }
    Mod+Shift+6 hotkey-overlay-title="Move Column to Workspace 6: move-column-to-workspace 6" { move-column-to-workspace 6; }
    Mod+Shift+7 hotkey-overlay-title="Move Column to Workspace 7: move-column-to-workspace 7" { move-column-to-workspace 7; }
    Mod+Shift+8 hotkey-overlay-title="Move Column to Workspace 8: move-column-to-workspace 8" { move-column-to-workspace 8; }
    Mod+Shift+9 hotkey-overlay-title="Move Column to Workspace 9: move-column-to-workspace 9" { move-column-to-workspace 9; }
    Mod+Shift+0 hotkey-overlay-title="Move Column to Workspace 10: move-column-to-workspace 10" { move-column-to-workspace 10; }

}
