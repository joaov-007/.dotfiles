// ─── Web Apps (Chromium browser, chromeless windows) ───
//  Included from binds.kdl — edit here, not in binds.kdl
//
//  Each site opens as its own app window: no tabs, no toolbar, so it
//  behaves like a native app under the tiling layout.
//
//  The browser is not named here. `webapp` picks the first Chromium-based
//  browser it finds — native binary first, then flatpak — so swapping Brave
//  for Ungoogled Chromium is a package change, not a config change.
//  Force one for a single launch with WEBAPP_BROWSER, e.g.
//      WEBAPP_BROWSER=ungoogled-chromium webapp https://example.com
//  Source: config/.local/bin/webapp (stowed to ~/.local/bin/webapp).
//
//  Repeated presses may stack a second window. Once you install a site
//  as a PWA in the browser (the install icon in the omnibox), swap
//  `--app=https://…` for `--app-id=<hash>` to get a dedicated icon and
//  single-instance behaviour (re-press focuses the open window).
//  Hashes live in:
//      ~/.local/share/applications/<browser>-*-Default.desktop
binds {

    Mod+Alt+g hotkey-overlay-title="GitHub (Web App)"   { spawn-sh "$HOME/.local/bin/webapp 'https://github.com'"; }
    Mod+Alt+i hotkey-overlay-title="GitLab (Web App)"   { spawn-sh "$HOME/.local/bin/webapp 'https://gitlab.com'"; }
    Mod+Alt+d hotkey-overlay-title="Drive (Web App)"    { spawn-sh "$HOME/.local/bin/webapp 'https://drive.google.com'"; }
    Mod+Alt+c hotkey-overlay-title="Codeberg (Web App)" { spawn-sh "$HOME/.local/bin/webapp 'https://codeberg.org'"; }
    Mod+Alt+y hotkey-overlay-title="YouTube (Web App)"  { spawn-sh "$HOME/.local/bin/webapp 'https://www.youtube.com'"; }
    Mod+Alt+w hotkey-overlay-title="WhatsApp (Web App)" { spawn-sh "$HOME/.local/bin/webapp 'https://web.whatsapp.com'"; }
    Mod+Alt+a hotkey-overlay-title="ChatGPT (Web App)"  { spawn-sh "$HOME/.local/bin/webapp 'https://chatgpt.com'"; }

    // Google stuff
    Mod+Alt+z hotkey-overlay-title="Google Calendar (Web App)" { spawn-sh "$HOME/.local/bin/webapp 'https://calendar.google.com'"; }
    Mod+Alt+p hotkey-overlay-title="Google Photos (Web App)"   { spawn-sh "$HOME/.local/bin/webapp 'https://photos.google.com'"; }
    Mod+Alt+m hotkey-overlay-title="Google Mail (Web App)"   { spawn-sh "$HOME/.local/bin/webapp 'https://mail.google.com'"; }

}
