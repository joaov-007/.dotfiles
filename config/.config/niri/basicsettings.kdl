// Generated by niri-settings - Edits will be overwritten!

// prefer-no-csd

overview {
    zoom 0.4
}

animations {
    on
    slowdown 1.0
}

// layout section removed — covered by layout/layout.kdl included in config.kdl

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
} 

// bloco `input` removido — movido para input/input.kdl (incluído em config.kdl).
// Se o niri-settings reescrever este arquivo, apague de novo o input daqui.

hotkey-overlay {
    hide-not-bound
    // skip-at-startup
    }

gestures {
    hot-corners {
        //off
        top-left
    }
}

debug {
    // honor-xdg-activation-with-invalid-serial 
}

cursor {
    // hide-when-typing 
    // hide-after-inactive-ms {self.behavior_tab.inactive_spinbox.value()}
}

    // * do not show backups
