#!/bin/sh
# dot — layered dotfile installer + per-OS package declarations.
# Layers (broad → specific): shared -> env/common -> env/$OS -> env/$HOST.
# Later layers override earlier ones.
#
# Usage:
#   ./bin/dot            # install/update dotfile symlinks
#   ./bin/dot pkgs       # install missing programs declared for this OS
#   ./bin/dot adopt <path>...   # adopt existing $HOME files into the repo
#   ./bin/dot remove     # remove dotfile symlinks, restore backups

set -eu

# shellcheck disable=SC1007
DOTFILES="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
CONFIG="$DOTFILES/config"
PKGS="$CONFIG/packages"
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
HOST="$(hostname | sed 's/\..*//' | tr '[:upper:]' '[:lower:]')"
TARGET="${DOTFILES_TARGET:-$HOME}"

LAYERS="shared env/common env/$OS env/$HOST"

command -v realpath >/dev/null 2>&1 || { echo "realpath required"; exit 1; }

# ── dotfiles ──────────────────────────────────────────────────────────────

dotfiles() {
    for layer in $LAYERS; do
        [ -d "$CONFIG/$layer" ] || continue
        echo "==> layer: $layer"
        find "$CONFIG/$layer" -type f | while read -r file; do
            rel="${file#"$CONFIG"/"$layer"/}"
            tgt="$TARGET/$rel"
            abs="$(realpath "$file")"
            dir="$(dirname "$tgt")"
            if [ -L "$dir" ]; then
                rm -f "$dir"
            fi
            mkdir -p "$dir"

            if [ -L "$tgt" ]; then
                if [ "$(readlink "$tgt")" = "$abs" ]; then
                    continue
                fi
                rm -f "$tgt"
            elif [ -e "$tgt" ]; then
                if [ -e "$abs" ]; then
                    if cmp -s "$tgt" "$abs" 2>/dev/null; then
                        # identical — replace real file with symlink, no data loss
                        rm -f "$tgt"
                        echo "   linked $tgt (identical to repo)"
                    else
                        # differs — back up user's file, link to repo
                        mv "$tgt" "$tgt.dotfiles.bak"
                        echo "   backed up $tgt -> $tgt.dotfiles.bak"
                    fi
                else
                    # no repo version — adopt user's file as canonical source
                    mkdir -p "$(dirname "$abs")"
                    mv "$tgt" "$abs"
                    echo "   adopted $tgt -> $abs"
                fi
            fi
            ln -s "$abs" "$tgt"
        done
    done
}

adopt() {
    for path in "$@"; do
        tgt="$TARGET/$path"
        abs="$CONFIG/shared/$path"
        if [ ! -e "$tgt" ] && [ ! -L "$tgt" ]; then
            echo "   skip: $tgt does not exist"
            continue
        fi
        if [ -e "$abs" ] || [ -L "$abs" ]; then
            echo "   conflict: $abs already exists in repo"
            continue
        fi
        if [ -L "$tgt" ]; then
            echo "   skip: $tgt is already a symlink"
            continue
        fi
        mkdir -p "$(dirname "$abs")"
        mv "$tgt" "$abs"
        echo "   adopted $tgt -> $abs"
        ln -s "$abs" "$tgt"
    done
}

remove_dotfiles() {
    find "$TARGET" -type l 2>/dev/null | while read -r link; do
        target="$(readlink "$link")"
        case "$target" in
            "$DOTFILES"/*)
                rm -f "$link"
                if [ -e "$link.dotfiles.bak" ]; then
                    mv "$link.dotfiles.bak" "$link"
                    echo "restored $link"
                else
                    echo "removed $link"
                fi
                ;;
        esac
    done
}

# ── packages ──────────────────────────────────────────────────────────────

has_cmd() { command -v "$1" >/dev/null 2>&1; }

pkg_installed() {
    # $1 = package name
    case "$PKG_MGR" in
        pacman)  pacman -Q "$1" >/dev/null 2>&1 ;;
        apt)     dpkg -s "$1" >/dev/null 2>&1 ;;
        pkg_add) pkg_info -e "$1" >/dev/null 2>&1 ;;
        pkg)     pkg info -e "$1" >/dev/null 2>&1 ;;
        *)       return 1 ;;
    esac
}

detect_pkg_mgr() {
    if has_cmd pacman; then PKG_MGR=pacman; PKG_INSTALL="sudo pacman -S --needed --noconfirm"
    elif has_cmd apt; then PKG_MGR=apt; PKG_INSTALL="sudo apt-get install -y"
    elif has_cmd pkg_add; then PKG_MGR=pkg_add; PKG_INSTALL="doas pkg_add"
    elif has_cmd pkg; then PKG_MGR=pkg; PKG_INSTALL="sudo pkg install -y"
    else
        echo "no supported package manager found (pacman, apt, pkg_add, pkg)"
        return 1
    fi
}

install_packages() {
    detect_pkg_mgr || return 1

    want=""
    [ -f "$PKGS/common" ] && want="$want $(cat "$PKGS/common")"
    [ -f "$PKGS/$OS" ] && want="$want $(cat "$PKGS/$OS")"
    want="$(printf '%s' "$want" | tr ' ' '\n' | sort -u | tr '\n' ' ')"

    missing=""
    for p in $want; do
        if ! pkg_installed "$p"; then
            missing="$missing $p"
        fi
    done

    if [ -z "$missing" ]; then
        echo "all packages already installed"
        return 0
    fi

    echo "installing:$missing"
    # shellcheck disable=SC2086
    $PKG_INSTALL $missing
}

# ── main ──────────────────────────────────────────────────────────────────

case "${1:-dotfiles}" in
    dotfiles|install) dotfiles ;;
    pkgs|packages)    install_packages ;;
    adopt)            shift; adopt "$@" ;;
    remove|uninstall) remove_dotfiles ;;
    *) echo "usage: $0 {dotfiles|pkgs|adopt <path>...|remove}"; exit 1 ;;
esac
