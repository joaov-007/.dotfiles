set shell := ["bash", "-euo", "pipefail", "-c"]

default: check

fmt:
    cargo fmt --all

fmt-check:
    cargo fmt --all -- --check

lint:
    cargo clippy --all-targets --all-features -- -D warnings

test:
    cargo test --all-features

audit:
    command -v cargo-audit >/dev/null || { echo "install: cargo install cargo-audit" >&2; exit 1; }
    cargo audit

deny:
    command -v cargo-deny >/dev/null || { echo "install: cargo install cargo-deny" >&2; exit 1; }
    cargo deny check

check: fmt-check lint test
    @echo "all green"

ci: fmt-check lint test audit
    @echo "all green"
