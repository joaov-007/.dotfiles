# --- NixOS: system configuration built with nixos-rebuild, never a dotfile
nixos

# --- repository tooling, not a dotfile package
scripts

# --- system files: they belong in /etc (sudo stow -t /etc etc)
etc

# --- leftovers from the old zsh layout
zsh.old

# --- documentation: it is read in the browser, not linked into $HOME
wiki

# --- the task list, for the same reason
^/TODO\.md$

# --- Obsidian per-device/workspace state. Patterns are Perl regexes matched
# --- against subpaths of the "/"-prefixed path, so no depth prefix is needed;
# --- there is no glob `**/` and no `!` negation in this file.
\.obsidian/(workspace.*|graph|hotkeys|community-plugins)\.json$
\.obsidian/plugins$
\.obsidian/snippets$

# --- written by the noctalia theme template on every theme change: it is
# --- machine state, not a dotfile
\.config/niri/noctalia\.kdl$

# --- stow defaults, repeated because this file replaces them
RCS
CVS
\.#.+       # CVS conflict files / emacs lock files
\.cvsignore
\.svn
_darcs
\.hg
\.git
\.gitignore
\.gitmodules
^/README.*
^/LICENSE.*
^/COPYING
.+~          # emacs backup files
\#.*\#       # emacs autosave files
